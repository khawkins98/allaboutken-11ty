{# <div><!-- empty --></div> #}
<div class="">
  <h1 class="kh-intro__heading"> 4-oh-no-4! <span class="emoji">😨</span></h1>
  <p class="kh-lede">This link is busted. Maybe these will help?</p>
  <p class="kh-intro__text">You can see search results for it below.</p>
</div>


<section class="embl-grid embl-grid--has-centered-content | kh-stack">
  <div>
    <h1 class="kh-text-body--1">Page not found</h1>
  </div>
  <div>
    {% set context = {
      search_client_button_text: "Search",
      search_client_autofocus: false,
      search_client_prompt: "Search the site",
      search_client_script: "/search_index.js",
      search_client_button: true,
      search_client_action: "/search/",
      search_client_results: true,
      search_client_id: "search_query",
      search_client_destination_prefix: ""
    } %}

    <form action="{{ context.search_client_action }}" method="GET" class="kh-form kh-form--search kh-form--search--responsive | kh-sidebar kh-sidebar--end">
      <div class="kh-sidebar__inner">
        <div class="kh-form__item | kh-search__item">
          <label class="kh-form__label kh-u-sr-only | kh-search__label" for="{{ search_client_id }}">{{ context.search_label }}</label>
          <input type="search" id="search" placeholder="{{ context.search_client_prompt }}" name="{{ context.search_client_id }}" class="vf-search__input | vf-form__input" {%- if search_client_autofocus %} autofocus{%- endif %} data-vf-search-client-side-input data-vf-search-client-side-destination-prefix="{{context.search_client_destination_prefix}}">
        </div>
        {%- if context.search_client_button -%}
        <button type="submit" class="kh-search__button | kh-button kh-button--primary">
          <span class="kh-button__text">{{ context.search_client_button_text }}</span>

          <svg class="kh-icon kh-icon--search-btn | kh-button__icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svgjs="http://svgjs.com/svgjs" viewBox="0 0 140 140" width="140" height="140"><g transform="matrix(5.833333333333333,0,0,5.833333333333333,0,0)"><path d="M23.414,20.591l-4.645-4.645a10.256,10.256,0,1,0-2.828,2.829l4.645,4.644a2.025,2.025,0,0,0,2.828,0A2,2,0,0,0,23.414,20.591ZM10.25,3.005A7.25,7.25,0,1,1,3,10.255,7.258,7.258,0,0,1,10.25,3.005Z" fill="#FFFFFF" stroke="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="0"></path></g></svg>
        </button>
        {%- endif -%}

      </div>
    </form>
  </div>
</section>

<script>
  // pre-populate the search with the query string
  var truncatedUrl = window.location.pathname.replace('.html','').replace('components/detail/','').replace('/',' ');
  document.getElementById('search').value = truncatedUrl;
</script>
