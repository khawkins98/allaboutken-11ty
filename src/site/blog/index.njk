---
title: The blog
teaser: "Thoughts, lessons learned, and the occasional web oddity."
layout: layouts/base.njk
pagination:
  data: collections.blogPosts
  size: 15
  alias: pagedPosts
permalink: "/blog/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}"
---
{%- set siteConfig = siteConfig.siteInformation -%}
<div class="kh-grid-stylized">
  <div>
  </div>
  <section>
    <h1 class="kh-font-headline kh-font-headline--display kh-text-heading--1">{{title}}</h1>
    {% include "partials/search-box.njk" %}
  {%- for post in pagedPosts -%}
    {% include "partials/post-summary.njk" %}
  {%- endfor -%}

  {% set pagerLabel = "Blog pagination" %}
  {% set pagerNewer = "Newer posts" %}
  {% set pagerOlder = "Older posts" %}
  {% include "partials/pager.njk" %}

  </section>
</div>
