---
title: The blog
subtitle: No homepage, yet.
date: 2018-08-22 12:24:50
layout: layouts/base.njk
#templateEngineOverride: njk
---
{%- set siteConfig = siteConfig.siteInformation -%}
<div class="kh-grid-stylized">
  <div>
    <h1 class="kh-text-heading--1 kh-font-now-alt kh-font-now-alt--display">{{title}}</h1>
  </div>
  <section>
  {%- for post in collections.posts | sort(true, true, attribute='date' ) -%}
  <article class="kh-summary kh-summary--news">
    <span class="kh-summary__date">{{ post.date | dateDisplay }}</span>
    <a class="kh-summary__image" href="{{ post.url | url}}">
      <img class="kh-summary__image" src="/images/crop-cinema{{ post.data.image | url }}" alt="{{ post.data.teaser }}" />
    </a>
    <h3 class="kh-summary__title | kh-font-now-alt">
      <a href="{{ post.url | url}}" class="kh-summary__link">{{ post.data.title }}</a>
    </h3>
    <p class="kh-summary__text | kh-content">{{ post.data.teaser | safe }}</p>
  </article>
  {%- endfor -%}
  </section>
</div>
