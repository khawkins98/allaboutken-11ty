---
title: The blog
teaser: "Thoughts, lessons learned, and the occasional web oddity."
layout: layouts/base.njk
pagination:
  data: collections.blogPosts
  size: 20
  alias: pagedPosts
permalink: "/blog/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}"
---
{%- set siteConfig = siteConfig.siteInformation -%}
<div class="kh-grid-stylized">
  <div>
  </div>
  <section>
    <h1 class="kh-font-headline kh-font-headline--display kh-text-heading--1">{{title}}</h1>
    {% include "partials/search-box.njk" %}
  {%- for post in pagedPosts -%}
  <article class="kh-summary kh-summary--news">
    {% set isNote = (post.data.tags and ('note' in post.data.tags))  %}
    <div class="kh-summary__date">{{ post.date | dateDisplay }}
    {% if isNote %}
      | Note post
    {% endif %}
    </div>
    {% if (not isNote) and post.data.image %}
      <a href="{{ post.url }}" class="kh-summary__image">
        <img width="300" class="kh-summary__image" src="/images{{ post.data.image }}" alt="{{ post.data.title }}">
      </a>
    {% endif %}
    <h3 class="kh-font-headline kh-summary__title">
      <a href="{{ post.url | url}}" class="kh-summary__link">{{ post.data.title }}</a>
    </h3>
    <p class="kh-content kh-summary__text">{{ post.data.teaser | emdash | safe }}</p>
  </article>
  {%- endfor -%}

  {% if pagination.hrefs.length > 1 %}
  <nav class="kh-pager" aria-label="Blog pagination">
    <ul class="kh-pager__list">
      {% if pagination.href.previous %}
        <li><a href="{{ pagination.href.previous }}" class="kh-pager__link">&larr; Newer posts</a></li>
      {% endif %}
      {% for href in pagination.hrefs %}
        <li>
          <a href="{{ href }}" class="kh-pager__link {% if loop.index0 == pagination.pageNumber %}kh-pager__link--current{% endif %}"{% if loop.index0 == pagination.pageNumber %} aria-current="page"{% endif %}>{{ loop.index }}</a>
        </li>
      {% endfor %}
      {% if pagination.href.next %}
        <li><a href="{{ pagination.href.next }}" class="kh-pager__link">Older posts &rarr;</a></li>
      {% endif %}
    </ul>
  </nav>
  {% endif %}

  </section>
</div>
