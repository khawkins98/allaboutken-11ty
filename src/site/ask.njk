---
title: Ask my site
date: 2020-09-12 21:24:50
layout: layouts/base.njk
templateEngineOverride: njk
noindex: true
---

<div data-pagefind-ignore>
<section class="kh-grid-stylized kh-stack">
  <div></div>
  <div>
    <h1>{{title}}</h1>
    <p class="kh-text-body--3">
      Type a question or topic in plain English and I'll find the most relevant posts.
      Everything runs in your browser -- no data is sent to any server.
    </p>

    <div class="kh-ask" aria-label="Semantic search conversation">
      <div class="kh-ask__conversation" id="ask-conversation" role="log" aria-live="polite" aria-relevant="additions">
      </div>

      <form class="kh-ask__input-area" id="ask-form" action="/ask/" method="GET">
        <label class="kh-u-sr-only" for="ask-input">Ask a question about this site</label>
        <input type="text" id="ask-input" name="q" placeholder="e.g. articles about improving search" class="kh-form__input kh-ask__input" autocomplete="off">
        <button type="submit" class="kh-button kh-ask__submit">Ask</button>
      </form>

      <noscript>
        <p>This feature requires JavaScript. You can use <a href="/search/">keyword search</a> instead.</p>
      </noscript>
    </div>

    <details class="kh-details">
      <summary><h3>How this works</h3></summary>
      <p>
        This page uses <strong>semantic search</strong> -- it understands the <em>meaning</em> of your question,
        not just keywords. At build time, every post is converted into a mathematical "fingerprint"
        (a 384-dimension vector) using a small language model called
        <a href="https://huggingface.co/Xenova/all-MiniLM-L6-v2">MiniLM-L6-v2</a>.
      </p>
      <p>
        When you ask a question, the same model runs in your browser to convert your question into a
        fingerprint, then finds posts with the most similar fingerprints. The model downloads once (~23 MB)
        and is cached by your browser for future visits.
      </p>
      <p>
        No AI generates the answers -- the results are real posts, ranked by relevance.
        For exact keyword matching, try <a href="/search/">keyword search</a>.
      </p>
    </details>
  </div>
</section>

<script type="module">
  const form = document.getElementById('ask-form');
  const input = document.getElementById('ask-input');
  const conversation = document.getElementById('ask-conversation');

  let extractor = null;
  let vectorData = null;
  let isLoading = false;

  function esc(s) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function addMessage(type, html) {
    const msg = document.createElement('div');
    msg.className = `kh-ask__message kh-ask__message--${type}`;
    msg.innerHTML = html;
    conversation.appendChild(msg);
    conversation.scrollTop = conversation.scrollHeight;
    return msg;
  }

  function cosineSimilarity(a, b) {
    let dot = 0;
    let normA = 0;
    let normB = 0;
    for (let i = 0; i < a.length; i++) {
      dot += a[i] * b[i];
      normA += a[i] * a[i];
      normB += b[i] * b[i];
    }
    return dot / (Math.sqrt(normA) * Math.sqrt(normB));
  }

  function formatDate(dateStr) {
    if (!dateStr) return '';
    try {
      const d = new Date(dateStr);
      return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    } catch {
      return '';
    }
  }

  function renderResults(results, query) {
    if (results.length === 0) {
      const searchUrl = `/search/?search_query=${encodeURIComponent(query)}`;
      return `<p>I couldn't find anything closely related to that. Try rephrasing, or use <a href="${searchUrl}">keyword search</a>.</p>`;
    }

    let intro;
    if (results.length === 1 && results[0].score > 0.45) {
      intro = '<p>I found one post that closely matches:</p>';
    } else {
      intro = `<p>Here are ${results.length} post${results.length === 1 ? '' : 's'} that might be relevant:</p>`;
    }

    const cards = results.map(r => {
      const date = formatDate(r.date);
      const score = Math.round(r.score * 100);
      const meta = [date, `${score}% match`].filter(Boolean).join(' · ');
      return `<div class="kh-ask__result">
        <a href="${esc(r.url)}"><h3>${esc(r.title || r.url)}</h3></a>
        ${r.teaser ? `<p>${esc(r.teaser)}</p>` : ''}
        <p class="kh-ask__result-meta">${esc(meta)}</p>
      </div>`;
    }).join('');

    const searchUrl = `/search/?search_query=${encodeURIComponent(query)}`;
    const fallback = `<p class="kh-ask__fallback">Not what you were looking for? Try <a href="${searchUrl}">keyword search</a>.</p>`;

    return `${intro}<div class="kh-ask__results">${cards}</div>${fallback}`;
  }

  async function loadModel(statusMsg) {
    // Fetch pre-computed vectors
    statusMsg.innerHTML = '<p>Loading search index...</p>';
    const resp = await fetch('/semantic-search/vectors.json');
    if (!resp.ok) throw new Error(`Failed to load vectors: ${resp.status}`);
    vectorData = await resp.json();

    // Import Transformers.js from CDN
    statusMsg.innerHTML = '<p>Loading search model (one-time ~23 MB download)...</p><progress id="model-progress" max="100" value="0"></progress>';
    const { pipeline: tfPipeline } = await import('https://cdn.jsdelivr.net/npm/@huggingface/transformers@3');

    const progressBar = document.getElementById('model-progress');

    extractor = await tfPipeline('feature-extraction', vectorData.model, {
      dtype: 'q8',
      progress_callback: (progress) => {
        if (progress.status === 'progress' && progressBar) {
          progressBar.value = Math.round(progress.progress);
        }
      },
    });
  }

  async function handleQuery(query) {
    if (!query.trim() || isLoading) return;
    isLoading = true;

    // Show user message
    addMessage('user', `<p>${esc(query)}</p>`);
    input.value = '';

    // Update URL
    const url = new URL(window.location);
    url.searchParams.set('q', query);
    window.history.replaceState({}, '', url);

    try {
      // Load model on first query
      if (!extractor) {
        const statusMsg = addMessage('status', '<p>Preparing search...</p>');
        await loadModel(statusMsg);
        statusMsg.remove();
      }

      const thinkingMsg = addMessage('status', '<p>Searching...</p>');

      // Embed query
      const output = await extractor(query, { pooling: 'mean', normalize: true });
      const queryVec = Array.from(output.data);

      // Rank documents by cosine similarity
      const scored = vectorData.documents.map(doc => ({
        ...doc,
        score: cosineSimilarity(queryVec, doc.embedding),
      }));

      scored.sort((a, b) => b.score - a.score);

      // Filter by threshold and limit
      const results = scored.filter(d => d.score > 0.25).slice(0, 5);

      thinkingMsg.remove();
      addMessage('system', renderResults(results, query));
    } catch (err) {
      console.error('Semantic search error:', err);
      const searchUrl = `/search/?search_query=${encodeURIComponent(query)}`;
      addMessage('system', `<p>Something went wrong loading the search model. You can try <a href="${searchUrl}">keyword search</a> instead.</p>`);
    }

    isLoading = false;
  }

  // Handle form submit
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    handleQuery(input.value);
  });

  // Check for ?q= on page load
  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q');
  if (initialQuery) {
    input.value = initialQuery;
    handleQuery(initialQuery);
  }
</script>
</div>
