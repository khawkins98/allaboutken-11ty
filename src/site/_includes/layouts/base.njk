<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preload" as="font" href="/assets/kh-font/IBMPlexSans-Regular.woff2" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="/assets/kh-font/IBMPlexMono-Regular.woff2" type="font/woff2" crossorigin>
    <link rel="stylesheet" media="all" href="{{ '/css/styles.css' | url }}" />
    <title>{{ title or (renderData and renderData.title) or siteConfig.siteInformation.title}} | All about Ken Hawkins</title>
    <link rel="canonical" href="https://www.allaboutken.com{{ page.url | url }}" />
    <link rel="webmention" href="https://webmention.io/allaboutken.com/webmention" />
    <link rel="pingback" href="https://webmention.io/allaboutken.com/xmlrpc" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/ken-favicon/assets/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/ken-favicon/assets/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/ken-favicon/assets/favicon-16x16.png">
    <link rel="manifest" href="/assets/ken-favicon/assets/site.webmanifest">
    <link rel="mask-icon" href="/assets/ken-favicon/assets/safari-pinned-tab.svg" color="#ffffff">
    <link rel="webmention" href="https://webmention.io/www.allaboutken.com/webmention" />    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="theme-color" content="#ffffff">
    <meta name="description" content="{{ (teaser or siteConfig.siteInformation.short_description) | striptags }}" />
    <meta name="MobileOptimized" content="width" />
    <meta name="HandheldFriendly" content="true" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    {% if noindex %}<meta name="robots" content="noindex,follow" />{% endif %}
    {#- OpenGraph and Twitter meta tags with defaults and per-post overrides #}
    {#- Compute values once for reuse #}
    {%- set ogTitleComputed = og_title or (title ~ " | All about Ken Hawkins") %}
    {%- set ogDescriptionComputed = og_description or teaser or siteConfig.siteInformation.short_description %}
    {%- if og_image %}
      {#- Explicit og_image override (full URL) - only way to bypass dynamic screenshots #}
      {%- set ogImageComputed = og_image %}
    {%- else %}
      {#- Default: dynamic screenshot from social card page #}
      {%- set ogImageComputed %}{% ogImageUrl %}{% endset %}
    {%- endif %}
    {#- OpenGraph meta tags #}
    {%- if tags and ('posts' in tags) %}
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content="{{ date }}" />
    <meta property="article:author" content="{{ siteConfig.siteInformation.author }}" />
    {% if tags %}{% for tag in tags %}<meta property="article:tag" content="{{ tag }}" />{% endfor %}{% endif %}
    {% else %}
    <meta property="og:type" content="website" />
    {% endif %}
    <meta property="og:site_name" content="All About Ken Hawkins" />
    <meta property="og:url" content="{{ siteConfig.siteInformation.url }}{{ page.url | url }}" />
    <meta property="og:title" content="{{ ogTitleComputed }}" />
    <meta property="og:description" content="{{ ogDescriptionComputed | striptags }}" />
    <meta property="og:image" content="{{ ogImageComputed }}" />
    {%- if image_meta and image_meta.alt %}<meta property="og:image:alt" content="{{ image_meta.alt }}" />{% endif %}
    {# Twitter Card meta tags #}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@khawkins98" />
    <meta name="twitter:site:id" content="3723201" />
    <meta name="twitter:creator" content="@khawkins98" />
    <meta name="twitter:creator:id" content="3723201" />
    <meta name="twitter:url" content="{{ siteConfig.siteInformation.url }}{{ page.url | url }}" />
    <meta name="twitter:title" content="{{ ogTitleComputed }}" />
    <meta name="twitter:description" content="{{ ogDescriptionComputed | striptags }}" />
    <meta name="twitter:image" content="{{ ogImageComputed }}" />
    {% if image_meta and image_meta.alt %}<meta name="twitter:image:alt" content="{{ image_meta.alt }}" />{% endif %}
    <meta name="dcterms.title" content="{{title}} > All About Ken Hawkins" />
    <meta name="dcterms.type" content="Text" />
    <meta name="dcterms.identifier" content="https://www.allaboutken.com{{page.url | url }}" />
    <meta name="dcterms.format" content="text/html" />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="https://www.allaboutken.com/rss.xml">
    <meta name="generator" content="{{ eleventy.generator }}">
    {%- if page.url == '/' %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "url": "https://www.allaboutken.com/",
      "name": "All about Ken Hawkins",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://www.allaboutken.com/search/?search_query={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
    </script>
    {% endif %}
  </head>
  <body class="kh-stack{% if bodyClass %} {{ bodyClass }}{% endif %}">
    {% include "partials/ambience.njk" -%}
    <a href="#main-content" class="kh-u-sr-only kh-skip-link">Skip to main content</a>
    <!-- Visible when CSS is off (hidden by CSS when on) -->
    <aside class="kh-css-off-note">If you're reading this the site styles are currently disabled. Toggle the “CSS” checkbox in the footer to restore styling.<hr></aside>
    <header class="kh-global-header" role="banner">
      <a href="/" class="kh-logo kh-navigation__link">AllAboutKen.com</a>
      <nav class="kh-cluster kh-navigation kh-u-do-not-print kh-u-show-for-medium">
        <ul class="kh-navigation__list">
          {#- One "Writing" entry rather than three siblings. Blog, Digesting
              and Project notes now read as sections of it, reached from
              /all/, and the nav stays active across all of them. -#}
          <li class="kh-navigation__item">
            <a href="/all/" class="kh-navigation__link{% if page.url.startsWith('/all') or page.url.startsWith('/blog') or page.url.startsWith('/digesting') or page.url.startsWith('/work') or page.url.startsWith('/posts') %} kh-navigation__link--active{% endif %}">Writing</a>
          </li>
          <li class="kh-navigation__item">
            <a href="/search/" class="kh-navigation__link{% if page.url.startsWith('/search') %} kh-navigation__link--active{% endif %}">Search</a>
          </li>
          <li class="kh-navigation__item">
            <a href="/#hello" class="kh-navigation__link">Contact</a>
          </li>
        </ul>
      </nav>
    </header>
    <main role="main" id="main-content" data-pagefind-body>
    {{ content | safe }}
    </main>
    {% include "footer.njk" %}
    {#- <!-- This page was generated on {{ site.buildTime | dateDisplay('LLL d, yyyy - HH:mm') }} --> #}
    <script src="{{ '/scripts.js' | url }}" defer></script>
    <script data-goatcounter="https://khawkins98.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </body>
</html>
