---
layout: layouts/base.njk
pageClass: posts
templateEngineOverride: njk
---

{%- set pulse = collections.allContent | pulseMonths(0) | collapseEmptyYears(timelineGaps) %}
{%- set pulseCurrentKey = date | dateDisplay('yyyy-LL') %}
{% include "partials/pulse-strip.njk" %}

<article class="kh-grid kh-grid__col-3">
  <div class="kh-grid__col--span-1">
    {% set isImpactStory = tags and ('impact-stories' in tags) %}
    {# Document reference: impact stories echo their IS-nn part number from
       the /work spec table; everything else gets a date ref from the slug. #}
    {% set docRef = (collections.impactStories | impactStoryRef(page.url)) if isImpactStory else null %}
    {% set docRef = docRef or (page | docRef) %}
    <div class="kh-post-head">
      <p class="kh-breadcrumb kh-post-head__strap">
        {% if isImpactStory %}
          <a href="/work">← Work</a>
        {% else %}
          <a href="/blog">← Blog</a>
        {% endif %}
        {% if docRef %}<span class="kh-doc-ref">Ref {{ docRef }}</span>{% endif %}
      </p>
      <h1 class="kh-font-headline kh-post-title kh-text-heading--1">{{title}}</h1>
      <p class="kh-meta kh-post-meta">
        <time datetime="{{ date }}">
          {% if isImpactStory %}{{ date | dateDisplay('y') }}{% else %}{{ date | dateDisplay }}{% endif %}
        </time>
        {%- set words = content | wordCount %}
        &middot; {{ words | formatNumber }} words
        {%- set lengthStats = words | lengthFrame %}
        {% include "partials/length-gauge.njk" %}
        {#- Topics may be hierarchical: "typography > OpenType ligatures". The
            parent is the controlled vocabulary and carries the tally; the
            child is free-form detail shown after it. -#}
        {% if topics %}&middot;
          {%- for topic in topics %}
          {%- set parent = topic | topicParent %}
          {%- set child = topic | topicChild %}
          {%- set tally = collections.allContent | topicTally(topic) %}
          {#- Tally closes the group rather than sitting between parent and
              child, where "retro computing x3 > emulation" reads as though
              the count belonged to the child. -#}
          {{ parent }}
          {%- if child %}<span class="kh-topic-child"><span class="kh-topic-child__sep" aria-hidden="true">&rsaquo;</span>{{ child }}</span>{% endif %}
          {%- if tally > 1 %}<span class="kh-topic-tally" title="{{ tally }} entries on {{ parent }}">&hairsp;×{{ tally }}</span>{% endif %}{{ ", " if not loop.last }}
          {%- endfor %}
        {%- endif %}
      </p>
    </div>
    {% include "partials/series-nav.njk" %}
    {%- set tocEntries = content | tocEntries %}
    {%- if tocEntries.length >= 2 %}
    <nav class="kh-post-rail" aria-label="Contents" data-pagefind-ignore>
      <p class="kh-meta kh-meta--accent kh-post-rail__label">Contents</p>
      <ol class="kh-post-rail__list">
        {%- for entry in tocEntries %}
        <li class="kh-post-rail__item">
          <a class="kh-post-rail__link" href="#{{ entry.id }}">
            <span class="kh-post-rail__num" aria-hidden="true">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
            <span class="kh-post-rail__text">{{ entry.text }}</span>
          </a>
        </li>
        {%- endfor %}
      </ol>
    </nav>
    {%- endif %}
  </div>
  <div class="kh-post--text kh-content kh-grid__col--span-2">
    {% if image %}
    <figure class="kh-figure">
      {% if href %}<a href="{{ href }}">{% endif %}
      <img class="kh-figure__image kh-figure__image--lead" src="/images{{ image | url }}" alt="{{ image_meta.altext or image_meta.alt or '' }}" decoding="async" fetchpriority="high">
      {% if href %}</a>{% endif %}
      {% if image_meta and image_meta.credit %}
      <small class="kh-figure__credit">{{ image_meta.credit | safe }}</small>
      {% endif %}
      {% if image_meta and image_meta.text %}
      <figcaption class="kh-figure__caption">{{ image_meta.text | safe }}</figcaption>
      {% endif %}
    </figure>
    {% endif %}

    <div class="kh-post-body">
      {% if tags and ('note' in tags) %}
      <div class="kh-note-box">
        <span class="kh-note-box__label">Note:</span>
        I'm getting more active by writing shorter form, more informal updates like this one.
      </div>
      {% endif %}
      {% if teaser -%}
      <p class="kh-text-body--1">{{ teaser | emdash | safe }}</p>
      {%- endif %}
      {{ content | safe }}
    </div>
  </div>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://www.allaboutken.com{{ page.url | url }}"
  },
  "headline": {{ title | dump | safe }},
  "description": {{ (teaser or siteConfig.siteInformation.short_description) | striptags | dump | safe }},
  "datePublished": {{ date | dump | safe }},
  "dateModified": {{ (updated or date) | dump | safe }},
  "author": {
    "@type": "Person",
    "name": {{ siteConfig.siteInformation.author | dump | safe }}
  },
  {% if image -%}
  "image": ["https://www.allaboutken.com/images{{ image | url }}"],
  {%- endif %}
  "publisher": {
    "@type": "Person",
    "name": {{ siteConfig.siteInformation.author | dump | safe }}
  }
}
</script>

<div class="kh-stack kh-u-padding__top--800" data-pagefind-ignore>
  {%- if page.url != '/privacy/' %}
  <article class="kh-grid kh-grid__col-3 kh-u-do-not-print">
    <div class="kh-grid__col--span-1">
    </div>
    <div class="kh-content kh-grid__col--span-2">
      {#- The tail of an entry answers two questions, in this order: who wrote
          this, and what should I read next. It used to answer them in five
          blocks that overlapped -- a "Comment?" section, a feedback strip, the
          byline, a "Read more" section, and a floating widget that duplicated
          the feedback strip outright. Contact now lives in the byline, because
          how to reach the author belongs in the author block, and everything
          onward lives under one heading. -#}

      {#- 1. WHO. Before the asks, not after them: a reader should know who
          they would be talking to before being invited to talk. -#}
      {% include "partials/author-note.njk" %}

      {%- if comment != false %}
      {% include "partials/feedback.njk" %}
      {%- endif %}

      {#- 2. WHAT NEXT. One heading over every onward route -- semantic
          neighbours, the sequence rail, and adjacent entries -- because they
          are all answers to the same question and were previously scattered
          across three blocks that did not know about each other. -#}
      <div class="kh-section-head kh-u-margin__top--1200">
        <h2 id="read-next" class="kh-text-heading--2">Read next</h2>
        <span class="kh-meta">By meaning, and in sequence</span>
      </div>

      {% include "partials/related-semantic.njk" %}

      <h3 class="kh-text-heading--3 kh-u-margin__top--800">In sequence</h3>
      {%- set seqNeighbours = collections.allContent | neighbourhood(page.url, 3) %}
      {% include "partials/sequence-mark.njk" %}
      {%- set previousPost = collections.posts | getPreviousCollectionItem(page) %}
      {%- set nextPost = collections.posts | getNextCollectionItem(page) %}

      {%- if previousPost %}
      <p class="kh-text-body--3">Previously: <a href="{{ previousPost.url | url}}">{{ previousPost.data.title }}</a></p>
      {% endif %}

      {%- if nextPost %}
      <p class="kh-text-body--3">Next: <a href="{{ nextPost.url | url}}">{{ nextPost.data.title }}</a></p>
      {%- endif %}
      <p>
        <a href="/blog" class="kh-button kh-button--sm"> ⇤ Blog index</a>
      </p>
    </div>
  </article>
  {%- endif %}
</div>

