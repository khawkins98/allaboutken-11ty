---
layout: layouts/base.njk
pageClass: posts
templateEngineOverride: njk
---

<article class="kh-grid kh-grid__col-3">
  <div class="kh-grid__col--span-1">
    <section class="kh-u-fullbleed kh-u-background-color--yellow--dark">
      <h1 class="kh-text-heading--1 kh-font-now-alt kh-font-now-alt--display | kh-post-title">{{title}}</h1>
    </section>
    <p><time datetime="{{ date }}" class="kh-summary__date">{{ date | dateDisplay }}</time> {% if topics %}&nbsp;&nbsp;<span class="kh-summary__author">Filed in: {{topics}}</span>{% endif %}</p>
  </div>
  <div class="kh-grid__col--span-2 kh-content">
    <figure class="kh-figure">
      {% if href %}<a href="{{ href }}">{% endif %}
      <img class="kh-figure__image" src="/images{{ image | url }}" alt="{{ image_meta.altext }}">
      {% if href %}</a>{% endif %}
      {% if image_meta and image_meta.text %}
      <figcaption class="kh-figure__caption">{{ image_meta.text | safe }}</figcaption>
      {% endif %}
    </figure>

    <section class="kh-grid kh-grid__col-3">
      <div class="kh-grid__col--span-2">
        {% if teaser -%}
        <p class="kh-text-body--1">{{ teaser | safe }}</p>
        {%- endif %}
        {{ content | safe }}
      </div>
      <div class="kh-grid__col--span-1">
      </div>
    </section>
  </div>
</article>

<div class="kh-stack kh-u-padding__top--800">
{% if comment != false %}
  <article class="kh-grid kh-grid__col-3 | do-not-print">
    <div class="kh-grid__col--span-1">
      <h2 class="kh-text-heading--2 | kh-u-float__right--md">Comment?</h2>
    </div>
    <div class="kh-grid__col--span-2 kh-content">
      <p>Thanks for reading, if you have comment I'd love to hear it.</p>
      <p>
        <a href="https://toot.io/@khawkins98">Mastodon<span class="show-for-large"> @khawkins98@toot.io</span></a>
        {# &nbsp; <a href="/rss.xml">RSS feed</a> #}
        &nbsp; <a href="https://www.linkedin.com/in/allaboutken">LinkedIn</a>
        {# &nbsp; <a href="mailto:khawkins98@gmail.com">E-mail</a> #}
        &nbsp; <a href="mailto:khawkins98@gmail.com">khawkins98@gmail.com</a>
      </p>
    </div>
  </article>
  {% endif %}

  {% if page.url != '/privacy/' %}
  <article class="kh-grid kh-grid__col-3 | do-not-print">
    <div class="kh-grid__col--span-1">
      <h2 class="kh-text-heading--2 | kh-u-float__right--md">Read more</h2>
    </div>
    <div class="kh-grid__col--span-2 kh-content">
      {% set previousPost = collections.posts | getPreviousCollectionItem(page) %}
      {% set nextPost = collections.posts | getNextCollectionItem(page) %}

      {% if previousPost %}
      <p class="kh-text-body--3">Previously: <a href="{{ previousPost.url | url}}" class="kh-link">{{ previousPost.data.title }}</a></p>
      {% endif %}

      {% if nextPost %}
      <p class="kh-text-body--3">Next: <a href="{{ previousPost.url | url}}" class="kh-link">{{ nextPost.data.title }}</a></p>
      {% endif %}

      <p>
        <a href="/blog" class="kh-button kh-button--secondary kh-button--sm"> ⇤ Blog index</a>
      </p>
    </div>
  </article>
  {% endif %}
</div>