---
layout: layouts/base.njk
pageClass: posts
templateEngineOverride: njk
---

<article class="kh-grid kh-grid__col-3">
  <div class="kh-grid__col--span-1">
    <section class="kh-u-background-color--yellow--dark kh-u-fullbleed">
      <h1 class="kh-font-headline kh-post-title kh-text-heading--1">{{title}}</h1>
    </section>
    <p><time datetime="{{ date }}" class="kh-summary__date">{{ date | dateDisplay }}</time>{% if topics %}<span class="kh-summary__author">Filed in: {{ topics | join(', ') }}</span>{% endif %}</p>
  </div>
  <div class="kh-content kh-grid__col--span-2">
    {% if image %}
    <figure class="kh-figure">
      {% if href %}<a href="{{ href }}">{% endif %}
      <img class="kh-figure__image kh-figure__image--lead" width="600" src="/images{{ image | url }}" alt="{{ image_meta.altext or '' }}">
      {% if href %}</a>{% endif %}
      {% if image_meta and image_meta.text %}
      <figcaption class="kh-figure__caption">{{ image_meta.text | safe }}</figcaption>
      {% endif %}
    </figure>
    {% endif %}

    <section class="kh-grid kh-grid__col-3">
      <div class="kh-grid__col--span-2">
        {% if tags and ('note' in tags) %}
        <div class="kh-note-box">
          <span class="kh-note-box__label">Note:</span>
          I'm getting more active by writing shorter form, more informal updates like this one.
        </div>
        {% endif %}
        {% if teaser -%}
        <p class="kh-text-body--1">{{ teaser | safe }}</p>
        {%- endif %}
        {{ content | safe }}
      </div>
      <div class="kh-grid__col--span-1">
      </div>
    </section>
  </div>
</article>

<div class="kh-stack kh-u-padding__top--800">
{%- if comment != false %}
  <article class="kh-grid kh-grid__col-3 kh-u-do-not-print">
    <div class="kh-grid__col--span-1">
    </div>
    <div class="kh-content kh-grid__col--span-2">
      <h2 class="kh-text-heading--2">Comment?</h2>
      <p>Thanks for reading, if you have comment I'd love to hear it.</p>
      <p class="kh-cluster">
        <a href="https://toot.io/@khawkins98">Mastodon<span class="kh-u-show-for-large"> @khawkins98@toot.io</span></a>
        <a href="https://www.linkedin.com/in/allaboutken">LinkedIn</a>
        <a href="mailto:khawkins98@gmail.com">khawkins98@gmail.com</a>
      </p>
    </div>
  </article>
  {%- endif %}

  {%- if page.url != '/privacy/' %}
  <article class="kh-grid kh-grid__col-3 kh-u-do-not-print">
    <div class="kh-grid__col--span-1">
    </div>
    <div class="kh-content kh-grid__col--span-2">
      <h2 class="kh-text-heading--2">Read more</h2>
      {%- set previousPost = collections.posts | getPreviousCollectionItem(page) %}
      {%- set nextPost = collections.posts | getNextCollectionItem(page) %}

      {%- if previousPost %}
      <p class="kh-text-body--3">Previously: <a href="{{ previousPost.url | url}}">{{ previousPost.data.title }}</a></p>
      {% endif %}

      {%- if nextPost %}
      <p class="kh-text-body--3">Next: <a href="{{ previousPost.url | url}}">{{ nextPost.data.title }}</a></p>
      {%- endif %}
      <p>
        <a href="/blog" class="kh-button kh-button--secondary kh-button--sm"> ⇤ Blog index</a>
      </p>
    </div>
  </article>
  {%- endif %}
</div>