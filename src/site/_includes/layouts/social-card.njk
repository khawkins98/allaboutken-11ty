<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Social card: {{ title | striptags }}</title>
<meta name="robots" content="noindex">
<style>
@font-face { font-family: 'Anton'; src: url('/assets/kh-font/Anton-Latin.woff2') format('woff2'); font-weight: 400; font-display: block; }
@font-face { font-family: 'IBM Plex Sans'; src: url('/assets/kh-font/IBMPlexSans-Regular.woff2') format('woff2'); font-weight: 400; font-display: block; }
@font-face { font-family: 'IBM Plex Sans'; src: url('/assets/kh-font/IBMPlexSans-SemiBold.woff2') format('woff2'); font-weight: 600; font-display: block; }
body:has(#kh-css-toggle:checked) {
  background: #faf9f5; color: #151515; font-family: 'IBM Plex Sans', Arial, sans-serif; font-synthesis-weight: none;
  height: 630px; margin: 0; overflow: hidden; width: 1200px;
  *, *::before, *::after { box-sizing: border-box; }
  .card { display: flex; flex-direction: column; height: 100%; isolation: isolate; overflow: hidden; position: relative; }
  .card::before { background: #f6d92f; border-radius: 50%; content: ''; height: 520px; position: absolute; right: 85px; top: -90px; width: 520px; z-index: -1; }
  .card::after { background: #ee3e35; bottom: -160px; content: ''; height: 360px; position: absolute; right: -130px; transform: rotate(35deg); width: 250px; z-index: -2; }
  .strap { align-items: center; display: flex; font-size: 21px; gap: 24px; justify-content: space-between; padding: 22px 48px; }
  .strap--top { border-bottom: 3px solid #151515; }
  .strap__mark { color: #173ebc; font-weight: 600; }
  .strap--bottom { background: #007c55; clip-path: polygon(0 18px, 100% 0, 100% 100%, 0 100%); color: white; font-size: 19px; margin-top: auto; padding-top: 40px; }
  .card-body { display: flex; flex: 1; flex-direction: column; justify-content: center; min-height: 0; padding: 24px 48px; }
  .title { display: -webkit-box; font-family: 'Anton', Impact, sans-serif; font-size: 72px; font-weight: 400; letter-spacing: -0.02em; line-height: 1.1; margin: 0 0 18px; max-width: 25ch; overflow: hidden; text-transform: uppercase; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .description { display: -webkit-box; font-size: 27px; line-height: 1.4; margin: 0; max-width: 66ch; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
}
</style></head><body>
<input type="checkbox" id="kh-css-toggle" checked hidden aria-hidden="true">
<div class="card">
  <div class="strap strap--top"><span class="strap__mark">AllAboutKen.com</span><span>{{ siteConfig.siteInformation.author }}</span></div>
  <div class="card-body"><h1 class="title">{{ title | striptags }}</h1><p class="description">{{ (teaser or siteConfig.siteInformation.short_description) | striptags }}</p></div>
  <div class="strap strap--bottom"><span>{% if cardPage.date and cardPage.data.tags and ('posts' in cardPage.data.tags or 'digesting' in cardPage.data.tags or 'photos' in cardPage.data.tags) %}{{ cardPage.date | dateDisplay }}{% endif %}</span><span>Digital platforms &amp; audience engagement</span></div>
</div></body></html>
