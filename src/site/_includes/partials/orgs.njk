{#- One description per organisation, shared by orgIntro (the note box at
    the top of a post) and orgSummary (plain text, e.g. a colophon row). -#}
{% macro orgSummary(id) %}
  {% set map = {
    'UNDRR': "The United Nations Office for Disaster Risk Reduction (UNDRR) is the UN's focal point for disaster risk reduction, coordinating global policy and supporting Member States to reduce disaster risk and losses.",
    'EMBL': "The European Molecular Biology Laboratory (EMBL) is an intergovernmental organization dedicated to life sciences research, with six sites across Europe conducting research, providing training, and delivering scientific services.",
    'EMBL-EBI': "The European Bioinformatics Institute (EMBL‑EBI) is EMBL's centre for bioinformatics, providing open data resources, tools and training to the global life sciences community.",
    'DRS Technical Solutions': "DRS Technical Solutions operated a global e-commerce platform serving satellite-connected customers with specialized telecommunications equipment and services."
  } %}
  {{- map[id] if map[id] else '' -}}
{% endmacro %}

{% macro orgIntro(id) %}
  {%- set text = orgSummary(id) | trim %}
  {% if text %}
  <div class="kh-note-box">
    <span class="kh-note-box__label">Context</span>
    {{ text | safe }}
  </div>
  {% endif %}
{% endmacro %}
