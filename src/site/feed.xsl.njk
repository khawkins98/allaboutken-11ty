permalink: feed.xsl
---
<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:a="http://www.w3.org/2005/Atom">
  <xsl:output method="html" encoding="UTF-8"/>
  <xsl:template match="/">
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <title><xsl:value-of select="a:feed/a:title" /> — Feed</title>
        <style>
          :root{--kh-body-width:81.25em;--kh-color--blue:#3b6fb6;--kh-color--blue--dark:#193f90;--kh-color--grey:#707372;--kh-color--grey--darkest:#373a36;--page-grid-gap:1rem}
          *{box-sizing:border-box}
          body{background:#fbf6ef;color:#222;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;line-height:1.6;margin:0}
          .container{max-width:var(--kh-body-width);margin:0 auto;padding:0 1em}
          header{margin:2rem 0 1.5rem}
          h1{font-size:42px;font-weight:700;line-height:1.25;margin:0 0 .25rem 0}
          .meta{color:var(--kh-color--grey);margin:.25rem 0 0 0}
          .entries{margin-top:2rem}
          .entry{border-top:1px solid #d0d0ce;padding-top:1rem;margin-top:1rem}
          .entry h2{font-size:27px;font-weight:500;line-height:1.333;margin:0 0 .25rem 0}
          .entry .date{color:var(--kh-color--grey);font-size:16px;line-height:1.71}
          .entry .summary{color:#000;font-size:22px;font-weight:300;line-height:1.45;margin:.25rem 0 0 0}
          a{color:var(--kh-color--blue);text-decoration:underline}
          a:hover{color:var(--kh-color--blue--dark)}
          a:visited{color:#563d82}
        </style>
      </head>
      <body>
        <div class="container">
          <header>
            <h1><xsl:value-of select="a:feed/a:title" /></h1>
            <div class="meta">
              <xsl:value-of select="a:feed/a:subtitle" />
              — <a href="{a:feed/a:link[not(@rel) or @rel='alternate'][1]/@href}">Visit site</a>
              — <a href="{a:feed/a:link[@rel='self'][1]/@href}">Feed</a>
            </div>
          </header>
          <div class="entries">
            <xsl:for-each select="a:feed/a:entry">
              <div class="entry">
                <h2><a href="{a:link/@href}"><xsl:value-of select="a:title" /></a></h2>
                <div class="date">
                  <xsl:text>Published: </xsl:text><xsl:value-of select="a:published" />
                </div>
                <div class="summary">
                  <xsl:value-of select="a:summary" />
                </div>
              </div>
            </xsl:for-each>
          </div>
        </div>
      </body>
    </html>
  </xsl:template>
</xsl:stylesheet>
