<style>
@font-face {
  font-family: 'Ken Cartridge Display';
  src: url('/assets/kh-font/ken-display/KenCartridgeDisplay-Variable.woff2') format('woff2');
  font-weight: 400;
  font-style: normal;
  font-stretch: 65% 115%;
  font-display: swap;
}
body:has(#kh-css-toggle:checked) .type-lab { --type-axis: 85; margin: 0 auto; max-width: 72rem; }
body:has(#kh-css-toggle:checked) .type-lab__kicker { font-family: var(--kh-font-mono); font-size: .75rem; color: #173ebc; }
body:has(#kh-css-toggle:checked) .type-lab__intro { max-width: 65ch; }
body:has(#kh-css-toggle:checked) .type-lab__controls { background: white; border: 2px solid #151515; box-shadow: 4px 4px #173ebc; padding: 1.25rem; margin: 2rem 0; }
body:has(#kh-css-toggle:checked) .type-lab__controls label { display: block; font-weight: 600; margin: 0 0 .5rem; }
body:has(#kh-css-toggle:checked) .type-lab__controls input[type='range'] { accent-color: #173ebc; display: block; width: 100%; min-height: 44px; margin: 0; }
body:has(#kh-css-toggle:checked) .type-lab__controls input[type='text'] { box-sizing: border-box; width: 100%; min-height: 48px; font: inherit; border: 2px solid #151515; padding: .5rem; }
body:has(#kh-css-toggle:checked) .type-lab__range-ends { display: flex; justify-content: space-between; font-family: var(--kh-font-mono); font-size: .75rem; margin-bottom: 1rem; }
body:has(#kh-css-toggle:checked) .type-lab__controls input:focus-visible { outline: 3px solid #173ebc; outline-offset: 4px; }
body:has(#kh-css-toggle:checked) .type-lab__sample { font-family: 'Ken Cartridge Display', Impact, sans-serif; font-stretch: 85%; font-variation-settings: 'wdth' var(--type-axis); font-weight: 400; font-synthesis: none; text-transform: uppercase; line-height: 1.15; overflow-wrap: anywhere; }
body:has(#kh-css-toggle:checked) .type-lab__hero { font-size: clamp(2.25rem, 7vw, 7.5rem); color: #173ebc; padding: 1.5rem 0; margin: 0; }
body:has(#kh-css-toggle:checked) .type-lab__row { border-top: 2px solid #151515; padding: 1.5rem 0; }
body:has(#kh-css-toggle:checked) .type-lab__row .type-lab__sample { font-size: clamp(1.75rem, 4.5vw, 4.5rem); margin: .5rem 0; }
body:has(#kh-css-toggle:checked) .type-lab__proof { font-family: 'Ken Cartridge Display', Impact, sans-serif; font-size: clamp(1.5rem, 3.25vw, 3rem); font-stretch: 85%; font-variation-settings: 'wdth' var(--type-axis); font-weight: 400; line-height: 1.4; overflow-wrap: anywhere; letter-spacing: .03em; margin: 1rem 0; }
