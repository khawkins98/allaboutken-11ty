---
permalink: rss.xml
metadata:
  filename: rss.xml
  path: feed/rss.xml
  url: https://www.allaboutken.com/rss.xml
  id: https://www.allaboutken.com
---
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/xsl" href="/feed.xsl"?>
{%- set siteConfig = siteConfig.siteInformation %}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ siteConfig.title }}</title>
  <subtitle>{{ siteConfig.short_description }}</subtitle>
  <link href="{{ metadata.url }}" rel="self"/>
  <link href="{{ siteConfig.url }}"/>
  <updated>{{ collections.posts | rssLastUpdatedDate }}</updated>
  <id>{{ metadata.id | ensureTrailingSlash }}</id>
  <logo>{{ metadata.id }}/assets/ken-favicon/assets/android-chrome-512x512.png</logo>
  <icon>{{ metadata.id }}/assets/ken-favicon/assets/favicon-32x32.png</icon>
  <author>
    <name>{{ siteConfig.author }}</name>
    <email>{{ siteConfig.email }}</email>
  </author>
  {%- for post in collections.posts | reverse | limitItems(10) %}
  {%- set absolutePostUrl %}{{ metadata.id }}{{ post.url }}{% endset %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ absolutePostUrl }}"/>
    <published>{{ post.date | rssDate }}</published>
    <updated>{{ post.date | rssDate }}</updated>
    <id>{{ absolutePostUrl | ensureTrailingSlash }}</id>
    <author>
      <name>{{ siteConfig.author }}</name>
      <email>{{ siteConfig.email }}</email>
    </author>
    {%- if post.data.topics %}
    {%- for topic in post.data.topics %}
    <category term="{{ topic }}" />
    {%- endfor %}
    {%- elseif post.data.tags %}
    {%- for tag in post.data.tags %}
    {%- if tag != 'posts' and tag != 'post' %}
    <category term="{{ tag }}" />
    {% endif %}
    {% endfor %}
    {% endif %}
    <summary type="html">{{ ((post.data.teaser | striptags) or (post.templateContent | striptags)) | escape }}</summary>
    <content type="html">{{ post.templateContent | sanitizeFeedHtml | htmlToAbsoluteUrls(metadata.id) }}</content>
  </entry>
  {%- endfor %}
</feed>
