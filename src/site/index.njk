<section class="kh-card-container kh-grid-stylized">
  <span></span>
  <section>
    <h2 id="recently" class="kh-text-heading--2">Recent writing</h2>

    {%- for post in collections.allContent | limitItems(10) -%}
    {% set tags = post.data.tags or [] %}
    {% set isDigesting = ('digesting' in tags) %}
    {% set isNote = ('note' in tags) %}
    {% set isImpactStory = ('impact-stories' in tags) %}
    <article class="kh-summary kh-summary--news{% if isDigesting %} kh-summary--highlight{% endif %}">
      {% if isDigesting %}<a href="/digesting" class="kh-summary__tab">Digesting</a>{% endif %}
      <div class="kh-summary__date">{{ post.date | dateDisplay }}{% if isImpactStory %} | <a href="/work">Project note</a>{% elif isNote %} | Note post{% endif %}</div>
      {% if (not isNote) and (not isDigesting) and post.data.image %}
        <a href="{{ post.url }}" class="kh-summary__image">
          <img width="300" class="kh-summary__image" src="/images{{ post.data.image }}" alt="{{ post.data.title }}">
        </a>
      {% endif %}
      <h3 class="kh-summary__title">
        <a href="{{ post.url }}" class="kh-summary__link">{{ post.data.title }}</a>
      </h3>
      <p class="kh-content kh-summary__text">{{ post.data.teaser | emdash | safe }}</p>
    </article>
    {%- endfor -%}
    <p class="kh-cluster">
      <a href="/blog">Blog ↦</a>
      <a href="/digesting">Digesting ↦</a>
      <a href="/work">Project notes ↦</a>
    </p>
  </section>

</section>

