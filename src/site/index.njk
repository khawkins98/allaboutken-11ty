      <a href="https://www.linkedin.com/in/allaboutken" >LinkedIn</a>
      <a href="mailto:khawkins98@gmail.com" >Email</a>
      <a href="https://untappd.com/user/khawkins98">Beer</a>
    </p>
  </section>
</section>
