#!/usr/bin/env bash
# Enforce the shared commit subject convention.
set -euo pipefail

msg_file="$1"
hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
validator="${hook_dir}/../scripts/validate-commit-subject.sh"

# First non-comment, non-empty line is the subject.
subject="$(sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$msg_file" | head -n 1 || true)"

"$validator" "$subject"
